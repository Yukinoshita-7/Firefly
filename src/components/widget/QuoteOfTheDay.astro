---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { quoteOfTheDayConfig } from "@/config/quoteOfTheDayConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

const quotes = quoteOfTheDayConfig.quotes;
const randomIndex = Math.floor(Math.random() * quotes.length);
const quote = quotes[randomIndex];
---

<WidgetLayout
  name={quoteOfTheDayConfig.title || i18n(I18nKey.quoteOfTheDay)}
  showTitle={showTitle}
  id="quote-of-the-day"
  class:list={[className]}
  style={style}
>
  <button slot="title-icon" class="quote-refresh" id="quote-refresh" aria-label="换一条" title="换一条">
    <Icon is:inline name="material-symbols:refresh-rounded" class="quote-refresh-icon" />
  </button>

  <div class="quote-container">
    <span class="quote-mark quote-mark-open" aria-hidden="true">&ldquo;</span>

    <blockquote id="quote-text" class="quote-text">
      {quote.text}
    </blockquote>

    <div class="quote-footer">
      <span class="quote-line" aria-hidden="true"></span>
      <cite id="quote-author" class="quote-author" data-empty={quote.author ? "false" : "true"}>
        {quote.author}
      </cite>
    </div>
  </div>
</WidgetLayout>

<script is:inline define:vars={{ quotes }}>
  (function () {
    function initQuote() {
      var refreshBtn = document.getElementById("quote-refresh");
      var textEl = document.getElementById("quote-text");
      var authorEl = document.getElementById("quote-author");
      if (!refreshBtn || !textEl || !authorEl) return;
      if (refreshBtn.dataset.bound === "true") return;
      refreshBtn.dataset.bound = "true";

      var current = textEl.textContent ? textEl.textContent.trim() : "";

      function pickQuote() {
        if (!quotes || quotes.length === 0) return;
        var next;
        if (quotes.length === 1) {
          next = quotes[0];
        } else {
          do {
            next = quotes[Math.floor(Math.random() * quotes.length)];
          } while (next.text === current);
        }
        current = next.text;

        var container = textEl.closest(".quote-container");
        if (container) container.classList.add("is-switching");

        setTimeout(function () {
          textEl.textContent = next.text;
          authorEl.textContent = next.author || "";
          authorEl.setAttribute("data-empty", next.author ? "false" : "true");
          if (container) container.classList.remove("is-switching");
        }, 220);
      }

      refreshBtn.addEventListener("click", function () {
        refreshBtn.classList.remove("spin");
        void refreshBtn.offsetWidth;
        refreshBtn.classList.add("spin");
        pickQuote();
      });
    }

    initQuote();
    document.addEventListener("swup:contentReplaced", initQuote);
  })();
</script>

<style>
  /* 刷新按钮 */
  .quote-refresh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    color: var(--primary);
    background: transparent;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .quote-refresh:hover {
    background: color-mix(in srgb, var(--primary) 14%, transparent);
  }
  .quote-refresh:active {
    transform: scale(0.92);
  }
  .quote-refresh-icon {
    font-size: 1.15rem;
  }
  .quote-refresh.spin .quote-refresh-icon {
    animation: quote-spin 0.5s ease;
  }
  @keyframes quote-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* 容器 */
  .quote-container {
    position: relative;
    padding: 1.15rem 1rem 1rem;
    border-radius: 0.85rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--primary) 8%, transparent),
      color-mix(in srgb, var(--primary) 2%, transparent)
    );
    overflow: hidden;
  }

  /* 装饰性引号 */
  .quote-mark {
    position: absolute;
    top: -0.35rem;
    left: 0.35rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 4rem;
    line-height: 1;
    font-weight: 700;
    color: var(--primary);
    opacity: 0.16;
    pointer-events: none;
    user-select: none;
  }

  /* 名言内容 */
  .quote-text {
    position: relative;
    z-index: 1;
    margin: 0.35rem 0 0;
    padding-left: 0.35rem;
    font-size: 0.98rem;
    line-height: 1.9;
    letter-spacing: 0.01em;
    color: rgb(64 64 64);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  :global(.dark) .quote-text {
    color: rgb(212 212 212);
  }

  /* 页脚：分隔线 + 作者 */
  .quote-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.9rem;
    transition: opacity 0.22s ease;
  }
  .quote-line {
    display: inline-block;
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--primary) 70%, transparent)
    );
  }
  .quote-author {
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 600;
    color: var(--primary);
    white-space: nowrap;
  }
  .quote-author[data-empty="true"] {
    display: none;
  }
  /* 无作者时隐藏分隔线 */
  .quote-footer:has(.quote-author[data-empty="true"]) .quote-line {
    display: none;
  }

  /* 切换动画 */
  .quote-container.is-switching .quote-text {
    opacity: 0;
    transform: translateY(6px);
  }
  .quote-container.is-switching .quote-footer {
    opacity: 0;
  }
</style>
